# Copia este archivo como .env y ajusta los valores.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Orígenes del frontend autorizados (separados por coma).
CORS_ORIGINS=http://localhost:5173

# Sin DATABASE_URL el historial se guarda en memoria y se pierde al reiniciar.
# El valor de abajo coincide con docker-compose.yml.
DATABASE_URL=postgres://loadtester:loadtester@localhost:5433/loadtester

# Límites de uso responsable.
MAX_VUS=500
MAX_DURATION_SECONDS=300
MAX_CONCURRENT_TESTS=2
RATE_LIMIT_PER_MINUTE=30

# Permite probar localhost sin verificar dominio. En producción es false por defecto.
ALLOW_LOCALHOST=true

# Motor de carga.
MAX_WORKERS=4
VUS_PER_WORKER=100
METRICS_INTERVAL_MS=1000

# Carpeta de los reportes generados (SSG).
REPORTS_DIR=storage/reports
