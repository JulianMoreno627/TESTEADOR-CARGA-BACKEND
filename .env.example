# Copia este archivo como .env y pon tus valores reales SOLO en .env.
# .env está en .gitignore: nunca se sube al repositorio.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Orígenes del frontend autorizados (separados por coma).
CORS_ORIGINS=http://localhost:5173

# Base de datos. Sin DATABASE_URL el historial se guarda en memoria.
# - Neon: copia la "connection string" del panel (la versión pooled), con este formato:
#   postgresql://<usuario>:<contraseña>@<host-de-neon>/neondb?sslmode=verify-full
#   (Neon la da terminada en ?sslmode=require&channel_binding=require: cámbiala a ?sslmode=verify-full)
# - Docker local (docker-compose.yml):
#   postgres://loadtester:loadtester@localhost:5433/loadtester
DATABASE_URL=

# IA: Gemini es el principal y Groq el respaldo. Basta con una de las dos.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# AI_TIMEOUT_MS=20000
# AI_RATE_LIMIT_PER_MINUTE=10

# Límites de uso responsable.
MAX_VUS=500
MAX_DURATION_SECONDS=300
MAX_CONCURRENT_TESTS=2
RATE_LIMIT_PER_MINUTE=30

# Permite probar localhost sin verificar dominio. En producción es false por defecto.
ALLOW_LOCALHOST=true

# Motor de carga.
MAX_WORKERS=4
VUS_PER_WORKER=100
METRICS_INTERVAL_MS=1000

# Carpeta de los reportes generados (SSG).
REPORTS_DIR=storage/reports
