{
  "name": "testeador-carga-visual-backend",
  "version": "1.0.0",
  "description": "Backend del Testeador de Carga Visual: motor de carga con Worker Threads, métricas en tiempo real y reportes.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "demo:target": "node scripts/demo-target.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "on-headers": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "socket.io-client": "^4.8.4",
    "yaml": "^2.9.1"
  }
}
